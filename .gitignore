# --- Rust / native build artifacts ---
target/
**/*.rs.bk

# --- Node / web build artifacts ---
node_modules/
js/.tools/
dist/
.astro/
# Type contracts for the generated dependency bundles are source inputs to the
# strict checker, not build artifacts. Keep them visible even when a developer's
# global ignore file contains a broad `build/` rule.
!js/build/
!js/build/*.d.mts
js/build/world-compiler.bundle.mjs

# --- Secrets & machine-specific local config (never publish) ---
.env
.env.*
/.mcp.json
/zaxy-mcp.json
/AGENTS.md

# --- Generated MCP wrapper (absolute paths baked in by install.sh / install.ps1) ---
/bin/limina-mcp
/bin/limina-mcp.cmd

# --- Zaxy memory store + generated runtime traces ---
.eventloom/
traces/
.limina/

# --- Spike scratch (large model weights / python envs — never commit) ---
/spikes/**/.venv/
/spikes/**/weights/
# Private competitor-analysis notes — keep out of the public repo.
/spikes/aperture-dx/

# --- Editor / OS ---
.claude/
.vscode/
.idea/
.DS_Store
*.swp
editor/vendor/

