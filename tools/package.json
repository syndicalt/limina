{
  "name": "limina-tools",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "limina HOST-SIDE tooling (asset pipeline converters). Deps here are NEVER imported by the sandboxed limina engine.",
  "scripts": {
    "architecture:compile": "bun architecture/compile-building.ts",
    "architecture:deps": "node architecture/blender-toolchain.mjs",
    "architecture:build": "bun architecture/build-building.ts",
    "architecture:build-shell": "bun architecture/build-shell.ts",
    "architecture:build-furniture": "bun architecture/build-furniture-pack.ts",
    "architecture:open": "node architecture/open-authoring.mjs",
    "material:fetch": "node material/fetch-ambientcg-cli.mjs",
    "test:material": "node --test material/*.test.mjs",
    "test:material-surface-browser": "node material/material-surface-browser-gate.mjs",
    "test:grass-field-browser": "node material/grass-field-browser-gate.mjs",
    "test:generated-river-browser": "node material/generated-river-browser-gate.mjs",
    "asset:flatten": "node asset/flatten-vegetation-glb-cli.mjs",
    "asset:lod": "node asset/generate-vegetation-lod-cli.mjs",
    "asset:retopo": "bun retopo/retopo-static-cli.mjs",
    "test:retopo": "bun test retopo/*.test.mjs",
    "test:asset": "node --test asset/*.test.mjs",
    "benchmark:visual": "node benchmark/run-visual-benchmark.mjs",
    "test:benchmark": "node --test benchmark/*.test.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.1.1",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.35.2"
  }
}
