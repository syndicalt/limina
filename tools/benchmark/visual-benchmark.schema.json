{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limina.dev/schemas/visual-benchmark-1.json",
  "title": "Limina record-only visual benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "recordOnly",
    "source",
    "export",
    "viewport",
    "simulation",
    "qualityProfile",
    "cameras",
    "output"
  ],
  "properties": {
    "schema": { "const": "limina.visual-benchmark/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "recordOnly": { "const": true },
    "source": { "$ref": "#/$defs/artifactSet" },
    "export": { "$ref": "#/$defs/artifactSet" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "deviceScaleFactor"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "fixedTimestepSeconds", "warmupFrames", "measureFrames"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "fixedTimestepSeconds": { "const": 0.016666666666666666 },
        "warmupFrames": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "measureFrames": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "qualityProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/camera" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": { "directory": { "$ref": "#/$defs/relativePath" } }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Portable project-relative path; the validator rejects absolute, traversal, empty-segment, and backslash forms."
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-tree-v1" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewPath", "viewSha256", "orbit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "viewPath": { "$ref": "#/$defs/relativePath" },
        "viewSha256": { "$ref": "#/$defs/sha256" },
        "orbit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "radius", "height", "maxRadius", "maxHeight", "far"],
          "properties": {
            "center": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number" },
            "maxRadius": { "type": "number", "exclusiveMinimum": 0 },
            "maxHeight": { "type": "number" },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
