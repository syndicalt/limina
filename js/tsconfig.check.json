{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["@webgpu/types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/bootstrap.ts", "src/demo.ts", "src/demos/**", "src/eyes/**"]
}
